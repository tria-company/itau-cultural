ackground: white;\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"font-size: 10.0pt; font-family: 'Arial',sans-serif; color: black; background: white;\"><em>Entreolhares</em> </span></strong><span style=\"font-size: 10.0pt; font-family: 'Arial',sans-serif; color: #4d5156; background: white;\">&ndash; </span><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"font-size: 10.0pt; font-family: 'Arial',sans-serif; color: black; background: white;\">Visitas (Pavilh&atilde;o da Bienal) <span style=\"font-size: 10.0pt; font-family: 'Arial',sans-serif; color: black; background: white;\">&ndash; INSCRI&Ccedil;&Otilde;ES PRORROGADAS</span></span></strong></p>\n<p style=\"margin: 0cm; margin-bottom: .0001pt; background: white;\"><span style=\"color: black; font-family: Arial, sans-serif; font-size: 10pt;\">inscri&ccedil;&otilde;es para as visitas<br></span><span style=\"font-size: 10.0pt; font-family: 'Arial',sans-serif; color: black; background: white;\">at&eacute; <strong style=\"mso-bidi-font-weight: normal;\">14 de novembro</strong>&nbsp;<br><a href=\"https://itaucultural.formstack.com/forms/entreolhares_bienal_dia20\" target=\"_blank\" rel=\"noopener\"><strong>clique aqui para se inscrever </strong></a><span style=\"font-size: 10.0pt; font-family: 'Arial',sans-serif; color: black; background: white;\"><a href=\"https://itaucultural.formstack.com/forms/entreolhares_bienal_dia20\" target=\"_blank\" rel=\"noopener\"><strong>&ndash; 1&ordm; encontro</strong></a><br></span><span style=\"color: rgb(230, 126, 35);\"><a style=\"color: rgb(230, 126, 35);\" href=\"https://itaucultural.formstack.com/forms/entreolhares_bienal_dia23\" target=\"_blank\" rel=\"noopener\"><strong>clique aqui para se inscrever <span style=\"font-size: 10pt; font-family: Arial, sans-serif; background: white;\">&ndash; 2&ordm; encontro</span></strong></a></span><br></span><span style=\"font-size: 10.0pt; font-family: 'Arial',sans-serif; color: black; background: white;\">divulga&ccedil;&atilde;o dos selecionados no dia <strong style=\"mso-bidi-font-weight: normal;\">17 de novembro</strong> (para ambas) <span style=\"font-size: 10.0pt; font-family: 'Arial',sans-serif; background: white;\"><span style=\"color: black;\"><span style=\"font-size: 10.0pt; font-family: 'Arial',sans-serif; background: white;\">(<em>site</em> do IC)</span></span></span><br style=\"mso-special-character: line-break;\"><!--[endif]--></span></p>\n<p style=\"margin: 0cm; margin-bottom: .0001pt; background: white;\"><strong style=\"mso-bidi-font-weight: normal;\"><span style=\"font-size: 10.0pt; font-family: 'Arial',sans-serif; color: black; background: white;\">Pavilh&atilde;o da Bienal</span></strong><span style=\"font-size: 10.0pt; font-family: 'Arial',sans-serif; color: black; background: white;\"> &ndash; Parque Ibirapuera</span><span style=\"font-size: 10.0pt; font-family: 'Arial',sans-serif; color: black; background: white;\"><!--[endif]--></span></p>","containerType":"regular","sectionType":"content","verticalAlignment":"align_top","styleSettings":null}]},"template_type":"default","observatorio_require_login":true,"site":{"id":1,"name":"Itaú Cultural","link":"itaucultural.org.br"},"section":"Notícias","hasAudioDescription":false,"hasAccessibility":false,"hasEstenotipia":false,"hasClosedCaption":false,"hasSubtitle":false,"hasDescriptiveSubtitle":false,"hasOpenCaption":false,"hasTraducao":false,"metaTitle":"“Entreolhares” realiza oficinas com artistas da “35ª Bienal” e visitas guiadas","metaDescription":"O programa de formação do Itaú Cultural acontece em novembro; faça sua inscrição","presential":false,"schedules":[],"ticket":false,"hideTicket":false,"soldOut":false,"online":false,"hideOnlineAccess":false},"items":[]},"__N_SSG":true}