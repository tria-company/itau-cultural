manentes: <i style=\"mso-bidi-font-style: normal;\"><a href=\"https://www.itaucultural.org.br/espaco-olavo-setubal\">Espa&ccedil;o Olavo Set&uacute;bal</a></i>, <i style=\"mso-bidi-font-style: normal;\"><a href=\"https://www.itaucultural.org.br/secoes/exposicoes/itau-cultural-ic-inaugura-exposicao-dedicada-a-numismatica-e-a-filatelia\">Espa&ccedil;o Herculano Pires &ndash; Arte no Dinheiro</a></i> e <i style=\"mso-bidi-font-style: normal;\"><a href=\"https://www.itaucultural.org.br/secoes/agenda/espaco-milu-villela-dedicado-as-artes-visuais-e-inaugurado-no-itau-cultural\">Espa&ccedil;o Mil&uacute; Vilela - Brasil das m&uacute;ltiplas faces</a></i>.</span></p>","containerType":"regular","sectionType":"content","verticalAlignment":"align_top","styleSettings":null}]},"template_type":"default","observatorio_require_login":true,"site":{"id":1,"name":"Itaú Cultural","link":"itaucultural.org.br"},"section":"Notícias","hasAudioDescription":false,"hasAccessibility":false,"hasEstenotipia":false,"hasClosedCaption":false,"hasSubtitle":false,"hasDescriptiveSubtitle":false,"hasOpenCaption":false,"hasTraducao":false,"metaTitle":"Confira o funcionamento do Itaú Cultural no Carnaval","metaDescription":"Instituição tem horário diferenciado durante o feriado prolongado","presential":false,"schedules":[],"ticket":false,"hideTicket":false,"soldOut":false,"online":false,"hideOnlineAccess":false},"items":[]},"__N_SSG":true}